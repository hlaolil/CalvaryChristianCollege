<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: title, styles: ['/css/pages/contact.css'] }) %>
<body>
  <%- include('partials/header') %>
  <main class="container">
    <h1>Contact Us</h1>
    <% if (success) { %>
      <p class="success">Thank you! Your message has been sent.</p>
    <% } %>
    <% if (error) { %>
      <p class="error" role="alert"><%= error %></p>
    <% } %>
    <!-- ==================== CONTACT FORM ==================== -->
    <form class="contact-form" action="/contact" method="POST" data-restore="<%= JSON.stringify(form) %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="f-name">Name *:</label>
      <input id="f-name" type="text" name="name" required value="<%= user?.name || '' %>" <%= user ? 'readonly' : '' %>>
      <label for="f-email">Email *:</label>
      <input id="f-email" type="email" name="email" required value="<%= user?.email || '' %>" <%= user ? 'readonly' : '' %>>
      <label for="f-phone">Phone (Optional):</label>
      <input id="f-phone" type="tel" name="phone" autocomplete="tel" placeholder="+266 5812 3456">
      <label for="f-message">Message *:</label>
      <textarea id="f-message" name="message" rows="6" required maxlength="5000" placeholder="How can we help you?"></textarea>
      <button type="submit">Send Message</button>
    </form>
    <p><a href="/">Back to Home</a></p>

    <!-- ==================== ADMIN: USERS + CONTACTS ==================== -->
    <% if (user?.role === 'admin') { %>
      <!-- === ALL USERS === -->
      <hr>
      <h2>All Registered Users</h2>
      <% if (users.length > 0) { %>
        <div class="table-wrapper">
          <table data-offset="<%= usersPage.offset %>">
            <thead>
              <tr>
                <th>#</th>
                <th class="sortable">Name</th>
                <th class="sortable">Email</th>
                <th class="sortable">Phone</th>
                <th class="sortable">Role</th>
                <th class="sortable" data-sort="date">Joined</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach((u, i) => { %>
                <tr>
                  <td data-label="#"> <%= usersPage.offset + i + 1 %> </td>
                  <td data-label="Name"> <%= u.name || '—' %> </td>
                  <td data-label="Email"> <%= u.email %> </td>
                  <td data-label="Phone"> <%= u.phoneNumber || '—' %> </td>
                  <td data-label="Role">
                    <span class="badge <%= u.role === 'admin' ? 'badge-admin' : '' %>">
                      <%= (u.role || 'user').toUpperCase() %>
                    </span>
                  </td>
                  <td data-label="Joined" data-value="<%= u.createdAt ? new Date(u.createdAt).toISOString() : '' %>">
                    <%= u.createdAt ? new Date(u.createdAt).toLocaleString('en-LS', { timeZone: 'Africa/Maseru' }) : '—' %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <%- include('partials/pagination', { page: usersPage, label: 'User pages' }) %>
      <% } else { %>
        <p><em>No users found.</em></p>
      <% } %>

      <!-- === ALL CONTACT MESSAGES === -->
      <hr>
      <h2>All Contact Form Submissions</h2>
      <% if (contacts.length > 0) { %>
        <div class="table-wrapper">
          <table data-offset="<%= contactsPage.offset %>">
            <thead>
              <tr>
                <th>#</th>
                <th class="sortable">Name</th>
                <th class="sortable">Email</th>
                <th class="sortable">Phone</th>
                <th class="sortable">Message</th>
                <th class="sortable" data-sort="date">Submitted</th>
              </tr>
            </thead>
            <tbody>
              <% contacts.forEach((c, i) => { %>
                <tr>
                  <td data-label="#"> <%= contactsPage.offset + i + 1 %> </td>
                  <td data-label="Name"> <%= c.name %> </td>
                  <td data-label="Email"> <%= c.email %> </td>
                  <td data-label="Phone"> <%= c.phone || '—' %> </td>
                  <td data-label="Message" class="message-cell"><%= c.message %></td>
                  <td data-label="Submitted" data-value="<%= c.date ? new Date(c.date).toISOString() : '' %>">
                    <%= new Date(c.date).toLocaleString('en-LS', { timeZone: 'Africa/Maseru' }) %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <%- include('partials/pagination', { page: contactsPage, label: 'Message pages' }) %>
      <% } else { %>
        <p><em>No contact messages yet.</em></p>
      <% } %>
    <% } %>
  </main>
  <%- include('partials/footer') %>

</body>
</html>
