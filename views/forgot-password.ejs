<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: title }) %>
<body>
  <%- include('partials/header') %>
  <main>
    <div class="auth-container">
      <h1>Forgot Password</h1>

      <% if (error) { %><p class="error"><%= error %></p><% } %>
      <% if (success) { %><p class="success"><%= success %></p><% } %>

      <% if (!success) { %>
        <p style="color:#555; margin-bottom:1.25rem; font-size:0.95rem;">
          Enter your registered email and we'll send you a link to reset your password.
        </p>
        <form class="auth-form" action="/auth/forgot-password" method="POST">
          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@example.com">
          </div>
          <button type="submit">Send Reset Link</button>
          <p><a href="/auth/login">Back to Login</a></p>
        </form>
      <% } else { %>
        <p style="text-align:center; margin-top:1rem;"><a href="/auth/login">Back to Login</a></p>
      <% } %>
    </div>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
