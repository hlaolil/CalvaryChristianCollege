<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: title }) %>
<body>
  <%- include('partials/header') %>
  <main>
    <% if (user) { %>
      <div class="auth-container">
        <h1>Already Logged In</h1>
        <p style="text-align:center;">You're logged in as <strong><%= user.name %></strong></p>
        <a href="<%= homeHref %>" class="btn-primary" style="display:block;text-align:center;margin-top:1rem;">Go to Dashboard</a>
      </div>
    <% } else { %>

      <div class="auth-container" style="max-width:560px;">
        <h1>Create Account</h1>

        <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>

        <form class="auth-form" action="/auth/register" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="form-group">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" required autocomplete="name" placeholder="John Doe" value="<%= form.name || '' %>">
          </div>

          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@example.com" value="<%= form.email || '' %>">
          </div>

          <div class="form-group">
            <label for="phoneNumber">Phone Number</label>
            <input type="tel" id="phoneNumber" name="phoneNumber" required autocomplete="tel" placeholder="+266 5812 3456" value="<%= form.phoneNumber || '' %>">
          </div>

          <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password" placeholder="At least 8 characters">
          </div>

          <div class="form-group">
            <label for="role">I am registering as</label>
            <select id="role" name="role" required>
              <% roles.forEach(r => { %>
                <option value="<%= r %>" <%= form.role === r ? 'selected' : '' %>><%= r.charAt(0).toUpperCase() + r.slice(1) %></option>
              <% }) %>
            </select>
          </div>

          <!-- ADMIN ONLY -->
          <div id="admin-secret" <%= form.role === 'admin' ? '' : 'hidden' %>>
            <div class="form-group">
              <label for="adminSecret">Admin Secret Key</label>
              <input type="password" id="adminSecret" name="adminSecret" autocomplete="off" placeholder="Enter admin secret">
            </div>
          </div>

          <!-- STUDENT ONLY -->
          <div id="student-fields" <%= form.role === 'student' ? '' : 'hidden' %>>
            <div class="form-group" style="margin-bottom:1rem;">
              <label for="studentNumber">Student Number</label>
              <input type="text" id="studentNumber" name="studentNumber" maxlength="6" pattern="[A-Za-z0-9]{6}"
                     placeholder="6 letters or digits (e.g. AB1234)" style="text-transform:uppercase;" value="<%= form.studentNumber || '' %>">
            </div>
            <div class="form-group">
              <label for="programOfStudy">Program of Study</label>
              <select id="programOfStudy" name="programOfStudy">
                <option value="">-- Select Program --</option>
                <% programGroups.forEach(group => { %>
                  <optgroup label="Level <%= group.level %> Programs">
                    <% group.programs.forEach(p => { %>
                      <option value="<%= p.title %>" <%= p.available ? '' : 'disabled' %> <%= form.programOfStudy === p.title ? 'selected' : '' %>>
                        <%= p.title %><%= p.available ? '' : ' (Coming Soon)' %>
                      </option>
                    <% }) %>
                  </optgroup>
                <% }) %>
              </select>
            </div>
          </div>

          <button type="submit">Create Account</button>
          <p>Already have an account? <a href="/auth/login">Login here</a></p>
        </form>
      </div>

    <% } %>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
