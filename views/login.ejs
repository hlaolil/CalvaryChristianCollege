<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: title }) %>
<body>
  <%- include('partials/header') %>
  <main>
    <% if (user) { %>
      <div class="auth-container">
        <h1>Welcome back!</h1>
        <p style="text-align:center;">Logged in as <strong><%= user.name %></strong></p>
        <a href="/academics" class="btn-primary" style="display:block;text-align:center;margin-top:1rem;">Go to Dashboard</a>
        <p style="text-align:center;margin-top:1rem;"><a href="/auth/logout">Logout</a></p>
      </div>
    <% } else { %>

      <div class="auth-container">
        <h1>Login</h1>

        <% if (error) { %><p class="error"><%= error %></p><% } %>
        <% if (query && query.reset === 'success') { %>
          <p class="success">Password reset successfully. Please log in.</p>
        <% } %>

        <form class="auth-form" action="/auth/login" method="POST">
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@example.com">
          </div>
          <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="Your password">
          </div>
          <button type="submit">Login</button>
          <p><a href="/auth/forgot-password">Forgot your password?</a></p>
        </form>
      </div>

      <p style="text-align:center; margin-top:0.5rem;">
        Don't have an account? <a href="/auth/register">Register here</a>
      </p>

    <% } %>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
