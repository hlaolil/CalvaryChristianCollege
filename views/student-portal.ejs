<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: title }) %>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    /* ---- Responsive table ---- */
    .table-wrapper {
      overflow-x: auto;
      margin: 1rem 0;
      border-radius: 8px;
      box-shadow: 0 2px 4px rgba(0,0,0,.1);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: .95rem;
      background: #fff;
    }
    th, td {
      padding: .75rem;
      text-align: left;
      border-bottom: 1px solid #ddd;
    }
    thead th {
      background: #e8f5e9;
      position: sticky;
      top: 0;
    }

    /* Sortable headers */
    th.sortable {
      cursor: pointer;
      user-select: none;
      position: relative;
      padding-right: 28px !important;
    }
    th.sortable:hover {
      background: #c8e6c9 !important;
    }
    th.sortable::after {
      content: "↕";
      position: absolute;
      right: 8px;
      opacity: 0.5;
      font-size: 0.9em;
    }
    th.sortable.asc::after {
      content: "↑";
      opacity: 1;
      font-weight: bold;
    }
    th.sortable.desc::after {
      content: "↓";
      opacity: 1;
      font-weight: bold;
    }

    /* Mobile: stack rows */
    @media (max-width: 640px) {
      .table-wrapper { overflow-x: hidden; }
      table, thead, tbody, th, td, tr { display: block; }
      thead tr { position: absolute; top: -9999px; left: -9999px; }
      tr {
        margin-bottom: 1rem;
        border: 1px solid #ddd;
        border-radius: 6px;
        padding: .5rem;
        background: #fafafa;
        box-shadow: 0 1px 3px rgba(0,0,0,.08);
      }
      td {
        border: none;
        position: relative;
        padding-left: 50%;
        white-space: normal;
        word-wrap: break-word;
      }
      td:before {
        content: attr(data-label);
        position: absolute;
        left: 6px;
        width: 45%;
        font-weight: bold;
        white-space: nowrap;
        color: #444;
      }
    }

    /* General styles */
    .error { color: red; font-weight: bold; }
    .success { color: green; font-weight: bold; }
    .warning { color: orange; font-weight: bold; }
    .info { color: #1976d2; font-weight: bold; }
    main a { color: #1976d2; text-decoration: none; }
    main a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <%- include('partials/header') %>
  <main class="container">
    <h1>Student Portal</h1>
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <!-- ==================== CURRENT STUDENT PROFILE ==================== -->
    <div class="profile-card">
      <h2>Welcome, <%= user.name %>!</h2>
      <p><strong>Student Number:</strong> <code style="font-size:1.05em; background:#f0f4fa; padding:2px 6px; border-radius:4px;"><%= user.studentNumber || '—' %></code></p>
      <p><strong>Email:</strong> <%= user.email %></p>
      <p><strong>Role:</strong> <span class="badge <%= user.role === 'admin' ? 'badge-admin' : '' %>"><%= user.role.toUpperCase() %></span></p>
      <p><strong>Joined:</strong> <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString() : '—' %></p>

      <% if (studentApp) { %>
        <hr style="margin:1rem 0; border:none; border-top:1px solid #eee;">
        <h3 style="margin-top:0;">Application Status</h3>
        <p><strong>Program:</strong> <%= studentApp.program %></p>
        <p><strong>Semester:</strong> <%= studentApp.semester %></p>
        <p><strong>Status:</strong>
          <span class="status-badge status-<%= (studentApp.status || 'pending').toLowerCase() %>">
            <%= studentApp.status || 'Pending' %>
          </span>
        </p>
        <p><strong>Submitted:</strong> <%= new Date(studentApp.submittedAt).toLocaleString('en-LS', { timeZone: 'Africa/Maseru' }) %></p>
        <% if (studentApp.status === 'Approved') { %>
          <p class="success">You are officially enrolled!</p>
        <% } else if (studentApp.status === 'Rejected') { %>
          <p class="error">Application declined. Please contact admin.</p>
        <% } else { %>
          <p class="info">Your application is under review.</p>
        <% } %>
      <% } else if (user.role === 'student') { %>
        <p class="warning">No application found. <a href="/apply">Apply Now</a></p>
      <% } %>
    </div>

    <!-- ==================== ADMIN: ALL STUDENTS ==================== -->
    <% if (user.role === 'admin') { %>
      <hr>
      <h2>All Students</h2>
      <% if (allStudents.length > 0) { %>
        <div class="table-wrapper">
          <table id="students-table">
            <thead>
              <tr>
                <th>#</th>
                <th class="sortable">Student #</th>
                <th class="sortable">Name</th>
                <th class="sortable">Email</th>
                <th class="sortable">Phone</th>
                <th class="sortable">Program</th>
                <th class="sortable">App Status</th>
                <th class="sortable">Submitted</th>
              </tr>
            </thead>
            <tbody>
              <% allStudents.forEach((s, i) => { %>
                <tr>
                  <td data-label="#"> <%= i + 1 %> </td>
                  <td data-label="Student #"> <code><%= s.studentNumber || '—' %></code> </td>
                  <td data-label="Name"> <%= s.name %> </td>
                  <td data-label="Email"> <%= s.email %> </td>
                  <td data-label="Phone"> <%= s.phoneNumber || '—' %> </td>
                  <td data-label="Program"> <%= s.programOfStudy || '—' %> </td>
                  <td data-label="App Status">
                    <span class="status-badge status-<%= (s.application.status || 'pending').toLowerCase() %>">
                      <%= s.application.status || 'Pending' %>
                    </span>
                  </td>
                  <td data-label="Submitted">
                    <%= s.application.submittedAt ? new Date(s.application.submittedAt).toLocaleDateString() : '—' %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p><em>No students registered yet.</em></p>
      <% } %>
    <% } %>

    <p><a href="/">Back to Home</a></p>
  </main>

  <%- include('partials/footer') %>

  <!-- Client-side sortable table script -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const table = document.getElementById("students-table");
      if (!table) return;

      const headers = table.querySelectorAll("th.sortable");

      headers.forEach(header => {
        header.addEventListener("click", () => {
          const index = Array.from(header.parentNode.children).indexOf(header);
          const isAsc = header.classList.toggle("asc");
          if (!isAsc) header.classList.add("desc");
          else header.classList.remove("desc");

          // Reset other headers
          headers.forEach(h => {
            if (h !== header) h.classList.remove("asc", "desc");
          });

          sortTable(table, index, isAsc);
        });
      });

      function sortTable(table, columnIndex, ascending) {
        const tbody = table.querySelector("tbody");
        const rows = Array.from(tbody.querySelectorAll("tr"));

        rows.sort((rowA, rowB) => {
          const cellA = rowA.children[columnIndex];
          const cellB = rowB.children[columnIndex];

          let valA = cellA.textContent.trim();
          let valB = cellB.textContent.trim();

          // Special handling for date column (Submitted)
          if (columnIndex === 7) { // Submitted date column
            if (valA === '—') valA = '';
            if (valB === '—') valB = '';
            if (!valA && !valB) return 0;
            if (!valA) return ascending ? 1 : -1;
            if (!valB) return ascending ? -1 : 1;

            const dateA = new Date(valA);
            const dateB = new Date(valB);
            return ascending ? dateA - dateB : dateB - dateA;
          }

          // Special handling for App Status (sort by text: Pending → Approved → Rejected)
          if (columnIndex === 6) {
            const order = { 'Pending': 0, 'Approved': 1, 'Rejected': 2 };
            const aOrder = order[valA] ?? -1;
            const bOrder = order[valB] ?? -1;
            return ascending ? aOrder - bOrder : bOrder - aOrder;
          }

          // Natural sort for everything else (numbers and strings)
          return ascending
            ? valA.localeCompare(valB, undefined, { numeric: true, sensitivity: 'base' })
            : valB.localeCompare(valA, undefined, { numeric: true, sensitivity: 'base' });
        });

        // Re-append rows in sorted order
        rows.forEach(row => tbody.appendChild(row));

        // Re-number the # column
        tbody.querySelectorAll("tr").forEach((row, i) => {
          row.children[0].textContent = i + 1;
        });
      }
    });
  </script>
</body>
</html>
