<header class="header">
  <div class="container">
    <!-- Logo -->
    <a href="/" class="logo-container">
      <img src="/images/logo.jpg" alt="Calvary Christian College home" class="logo" width="85" height="75">
    </a>

    <!-- Mobile Menu Toggle -->
    <button type="button" class="nav-toggle" aria-label="Toggle navigation" aria-controls="nav-menu" aria-expanded="false">
      Menu
    </button>

    <!-- Navigation -->
    <nav aria-label="Main">
      <ul id="nav-menu">
        <li><a href="/" class="<%= path === '/' ? 'active' : '' %>">Home</a></li>
        <li><a href="/about" class="<%= path === '/about' ? 'active' : '' %>">About Us</a></li>
        <li><a href="/academics" class="<%= path === '/academics' ? 'active' : '' %>">Academics</a></li>
        <li><a href="/contact" class="<%= path === '/contact' ? 'active' : '' %>">Contact Us</a></li>

        <!-- Donate Button -->
        <li><button type="button" class="donate" data-open-dialog="donateModal">Donate</button></li>

        <% if (user) { %>
          <% if (user.role === 'applicant') { %>
            <li><a href="/apply" class="<%= path === '/apply' ? 'active' : '' %>">Apply</a></li>
          <% } else if (user.role === 'alumni') { %>
            <li><a href="/alumni" class="<%= path === '/alumni' ? 'active' : '' %>">Join Alumni Community</a></li>
          <% } else if (user.role === 'student') { %>
            <li><a href="/student-portal" class="<%= path === '/student-portal' ? 'active' : '' %>">Student Portal</a></li>
          <% } else if (user.role === 'admin') { %>
            <li><a href="/apply" class="<%= path === '/apply' ? 'active' : '' %>">Applications</a></li>
            <li><a href="/alumni" class="<%= path === '/alumni' ? 'active' : '' %>">Alumni</a></li>
            <li><a href="/student-portal" class="<%= path === '/student-portal' ? 'active' : '' %>">Students</a></li>
          <% } %>
        <% } else { %>
          <li><a href="/auth/login" class="<%= path === '/auth/login' ? 'active' : '' %>">Login</a></li>
        <% } %>
      </ul>
    </nav>

    <!-- User Section -->
    <% if (user) { %>
      <div class="user-nav">
        <span>Welcome, <%= user.name %>!</span>
        <form action="/auth/logout" method="POST" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="link-button">Logout</button>
        </form>
      </div>
    <% } %>
  </div>
</header>

<!-- Donate Dialog -->
<dialog id="donateModal" class="modal" aria-labelledby="donateTitle">
  <div class="modal-content">
    <button type="button" class="close-btn" data-close-dialog aria-label="Close">&times;</button>
    <h2 id="donateTitle" class="visually-hidden">Banking details for donations</h2>
    <img src="/images/IMG-20260507-WA0037%20(2).webp"
         srcset="/images/IMG-20260507-WA0037%20(2).webp 571w, /images/IMG-20260507-WA0037.webp 1142w"
         sizes="(max-width: 640px) 90vw, 571px"
         alt="Calvary Christian College banking details" loading="lazy" width="571" height="619">
  </div>
</dialog>
