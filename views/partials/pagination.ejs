<% if (page.pages > 1) { %>
  <% const href = n => { const p = new URLSearchParams(); Object.entries(page.query || {}).forEach(([k, v]) => { if (typeof v === 'string' && k !== page.param && k !== 'success') p.set(k, v); }); p.set(page.param, n); return '?' + p.toString(); }; %>
  <nav class="pagination" aria-label="<%= typeof label !== 'undefined' ? label : 'Pages' %>">
    <% if (page.current > 1) { %>
      <a href="<%= href(page.current - 1) %>" rel="prev">&larr; Previous</a>
    <% } %>
    <span>Page <%= page.current %> of <%= page.pages %> (<%= page.total %> total)</span>
    <% if (page.current < page.pages) { %>
      <a href="<%= href(page.current + 1) %>" rel="next">Next &rarr;</a>
    <% } %>
  </nav>
<% } %>
