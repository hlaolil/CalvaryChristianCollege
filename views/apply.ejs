<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: title, styles: ['/css/pages/apply.css'] }) %>
<body>
  <%- include('partials/header') %>
  <main class="container">
    <h1>Application Form</h1>
    <% if (success) { %><p class="success">Application submitted successfully!</p><% } %>
    <% if (error) { %><p class="error"><%= error %></p><% } %>

    <!-- ==================== ACCESS CONTROL ==================== -->
    <% if (user.role === 'student') { %>
      <div class="info">You are enrolled as a student. Visit your <a href="/student-portal">Student Portal</a> to view your status.</div>
    <% } else if (user.role === 'alumni') { %>
      <div class="info">As an alumni, please visit the <a href="/alumni">Alumni Registration</a> page instead.</div>
    <% } %>

    <!-- ==================== USER FORM ==================== -->
    <% if (user.role === 'applicant' || user.role === 'admin') { %>

    <% if (user.role === 'applicant' && existingApplication) { %>
      <!-- Already applied — show status card -->
      <div class="profile-card" style="margin:1.5rem 0;">
        <h2 style="margin-top:0;">Your Application</h2>
        <p><strong>Program:</strong> <%= existingApplication.program %></p>
        <p><strong>Semester:</strong> <%= existingApplication.semester %></p>
        <p><strong>Status:</strong>
          <span class="status-badge status-<%= (existingApplication.status || 'pending').toLowerCase() %>">
            <%= existingApplication.status || 'Pending' %>
          </span>
        </p>
        <p><strong>Submitted:</strong> <%= new Date(existingApplication.submittedAt).toLocaleString('en-LS', { timeZone: 'Africa/Maseru' }) %></p>
        <% if (existingApplication.status === 'Approved') { %>
          <p class="success">Your application has been approved! Contact the college for next steps.</p>
        <% } else if (existingApplication.status === 'Rejected') { %>
          <p class="error">Your application was not approved. Please contact the admin for more information.</p>
        <% } else { %>
          <p class="info">Your application is under review. We will be in touch soon.</p>
        <% } %>
      </div>
    <% } else if (user.role === 'applicant') { %>
      <form class="application-form" action="/apply" method="POST" data-restore="<%= JSON.stringify(form) %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <!-- Personal Information -->
        <div class="form-section">
          <h2>Personal Information</h2>
          <div class="form-group">
            <label for="f-name">Name:</label>
            <input id="f-name" type="text" name="name" value="<%= user.name %>" readonly>
          </div>
          <div class="form-group">
            <label for="f-email">Email:</label>
            <input id="f-email" type="email" name="email" value="<%= user.email %>" readonly>
          </div>
          <div class="form-group">
            <label for="f-phone">Phone Number *:</label>
            <input id="f-phone" type="tel" name="phone" required autocomplete="tel" placeholder="+266 5812 3456" value="<%= user.phoneNumber || '' %>">
          </div>
          <div class="form-group">
            <label for="f-dob">Date of Birth *:</label>
            <input id="f-dob" type="date" name="dob" required max="<%= new Date().toISOString().split('T')[0] %>">
          </div>
          <div class="form-group">
            <label for="f-street_address">Street Address *:</label>
            <input id="f-street_address" type="text" name="street_address" required placeholder="123 Main Street">
          </div>
          <div class="form-group">
            <label for="f-town">Town/City *:</label>
            <input id="f-town" type="text" name="town" required placeholder="Maseru">
          </div>
          <div class="form-group">
            <label for="f-district">District *:</label>
            <select id="f-district" name="district" required>
              <option value="">Select District</option>
              <% ['Berea','Butha-Buthe','Leribe','Mafeteng','Maseru','Mohale\'s Hoek','Mokhotlong','Qacha\'s Nek','Quthing','Thaba-Tseka'].forEach(d => { %>
                <option value="<%= d %>"><%= d %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="f-postal_code">Postal Code *:</label>
            <input id="f-postal_code" type="text" name="postal_code" required placeholder="100">
          </div>
          <div class="form-group">
            <label for="f-country">Country:</label>
            <input id="f-country" type="text" name="country" value="Lesotho" readonly>
          </div>
        </div>
        <!-- High School -->
        <div class="form-section">
          <h2>High School Education</h2>
          <div class="form-group">
            <label for="f-high_school">High School *:</label>
            <input id="f-high_school" type="text" name="high_school" required placeholder="Maseru High School">
          </div>
          <div class="form-group">
            <label for="f-grad_year">Graduation Year *:</label>
            <input id="f-grad_year" type="number" name="grad_year" required min="1950" max="<%= currentYear %>" placeholder="<%= currentYear - 1 %>">
          </div>
        </div>
        <!-- Church / Spiritual -->
        <div class="form-section">
          <h2>Church & Spiritual Information</h2>
          <% const yesNo = ['','Yes','No']; %>
          <% yesNoFields.forEach(field => { %>
            <div class="form-group">
              <label for="f-<%= field %>"><%= field.replace(/_/g,' ').replace(/\b\w/g, l => l.toUpperCase()) %> *:</label>
              <select id="f-<%= field %>" name="<%= field %>" required>
                <% yesNo.forEach(opt => { %>
                  <option value="<%= opt %>"><%= opt || 'Select' %></option>
                <% }) %>
              </select>
            </div>
          <% }) %>
          <div class="form-group">
            <label for="f-current_church_name">Current Church Name *:</label>
            <input id="f-current_church_name" type="text" name="current_church_name" required>
          </div>
          <div class="form-group">
            <label for="f-current_church_city">Current Church City *:</label>
            <input id="f-current_church_city" type="text" name="current_church_city" required>
          </div>
          <div class="form-group">
            <label for="f-current_church_country">Current Church Country *:</label>
            <input id="f-current_church_country" type="text" name="current_church_country" required value="Lesotho">
          </div>
          <div class="form-group">
            <label for="f-pastor_name">Pastor's Name *:</label>
            <input id="f-pastor_name" type="text" name="pastor_name" required>
          </div>
          <div class="form-group">
            <label for="f-church_denomination">Church Denominational Affiliation *:</label>
            <input id="f-church_denomination" type="text" name="church_denomination" required placeholder="e.g., Assemblies of God">
          </div>
          <div class="form-group">
            <label for="f-personal_denomination">Personal Denominational Affiliation *:</label>
            <input id="f-personal_denomination" type="text" name="personal_denomination" required>
          </div>
          <div class="form-group">
            <label for="f-ministry_positions">Ministry Positions *:</label>
            <textarea id="f-ministry_positions" name="ministry_positions" rows="4" required placeholder="List all current positions (e.g., Youth Leader, Worship Team)..."></textarea>
          </div>
          <div class="form-group">
            <label for="f-national_leader_name">National Church Leader Name *:</label>
            <input id="f-national_leader_name" type="text" name="national_leader_name" required>
          </div>
          <div class="form-group">
            <label for="f-national_leader_position">Position *:</label>
            <input id="f-national_leader_position" type="text" name="national_leader_position" required>
          </div>
          <div class="form-group">
            <label for="f-national_leader_address">Address & Contact *:</label>
            <textarea id="f-national_leader_address" name="national_leader_address" rows="3" required placeholder="Full address, phone, email..."></textarea>
          </div>
        </div>
        <!-- Program -->
        <div class="form-section">
          <h2>Program Information</h2>
          <div class="form-group">
            <label for="f-program">Program *:</label>
            <select id="f-program" name="program" required>
              <option value="">Select Program</option>
              <% programGroups.forEach(group => { %>
                <optgroup label="Level <%= group.level %>">
                  <% group.programs.forEach(p => { %>
                    <option value="<%= p.title %>" <%= p.available ? '' : 'disabled' %>><%= p.title %><%= p.available ? '' : ' (Coming Soon)' %></option>
                  <% }) %>
                </optgroup>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="f-semester">Intake *:</label>
            <select id="f-semester" name="semester" required>
              <option value="">Select Intake</option>
              <% semesters.forEach(sem => { %>
                <option value="<%= sem %>"><%= sem %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="f-message">Message (Optional):</label>
            <textarea id="f-message" name="message" rows="4" placeholder="Any additional information..."></textarea>
          </div>
          <p><strong>Application Fee: M200</strong> (payable upon submission).
            The college's banking details are under <button type="button" class="link-button" data-open-dialog="donateModal">Donate</button> in the menu.
            If you need help with payment, please <a href="/contact">contact us</a>.</p>
          <button type="submit">Submit Application</button>
        </div>
      </form>
    <% } %> <!-- end applicant form / existingApplication block -->

      <p><a href="/">Back to Home</a></p>

      <!-- ==================== ADMIN: ALL APPLICATIONS TABLE ==================== -->
      <% if (user.role === 'admin') { %>
        <hr>
        <div class="admin-applications">
          <h2>All Submitted Applications</h2>
          <% if (applications.length > 0) { %>
            <div class="table-wrapper">
              <table id="applications-table" data-offset="<%= page.offset %>">
                <thead>
                  <tr>
                    <th>#</th>
                    <th class="sortable">Name</th>
                    <th class="sortable">Email</th>
                    <th class="sortable">Phone</th>
                    <th class="sortable">Program</th>
                    <th class="sortable">Semester</th>
                    <th class="sortable" data-sort="status">Status</th>
                    <th class="sortable" data-sort="date">Submitted</th>
                    <th>Actions</th>
                    <th>Details</th>
                  </tr>
                </thead>
                <tbody>
                  <% applications.forEach((app, index) => { %>
                    <tr>
                      <td data-label="#"> <%= page.offset + index + 1 %> </td>
                      <td data-label="Name"> <%= app.name %> </td>
                      <td data-label="Email"> <%= app.email %> </td>
                      <td data-label="Phone"> <%= app.phone %> </td>
                      <td data-label="Program"> <%= app.program %> </td>
                      <td data-label="Semester"> <%= app.semester %> </td>
                      <td data-label="Status">
                        <span class="status-badge status-<%= (app.status || 'pending').toLowerCase() %>">
                          <%= (app.status || 'Pending').toUpperCase() %>
                        </span>
                      </td>
                      <td data-label="Submitted" data-value="<%= app.submittedAt ? new Date(app.submittedAt).toISOString() : '' %>">
                        <%= new Date(app.submittedAt).toLocaleString('en-LS', { timeZone: 'Africa/Maseru' }) %>
                      </td>
                      <td data-label="Actions" class="details-cell">
                        <form action="/apply/<%= app._id %>/status" method="POST">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="returnTo" value="?page=<%= page.current %>">
                          <div class="action-btns">
                            <button type="submit" name="status" value="Approved" class="action-btn approve-btn"
                              <%= (app.status||'pending').toLowerCase() === 'approved' ? 'disabled' : '' %>>Approve</button>
                            <button type="submit" name="status" value="Rejected" class="action-btn reject-btn"
                              <%= (app.status||'pending').toLowerCase() === 'rejected' ? 'disabled' : '' %>>Reject</button>
                            <button type="submit" name="status" value="Pending" class="action-btn pending-btn"
                              <%= (app.status||'pending').toLowerCase() === 'pending' ? 'disabled' : '' %>>Pending</button>
                          </div>
                        </form>
                      </td>
                      <td data-label="Details" class="details-cell">
                        <details>
                          <summary style="cursor:pointer; color:var(--primary); font-weight:600;">View Details</summary>
                          <div style="margin-top:.8rem; line-height:1.6; font-size:.92rem;">
                            <div><strong>Personal:</strong> DOB <%= new Date(app.dob).toLocaleDateString() %>, <%= app.district %></div>
                            <div><strong>Education:</strong> <%= app.high_school %> (<%= app.grad_year %>)</div>
                            <div><strong>Church:</strong> <%= app.current_church_name %>, Pastor: <%= app.pastor_name %></div>
                            <% if (app.message) { %>
                              <div><strong>Message:</strong> <%= app.message %></div>
                            <% } %>
                          </div>
                        </details>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <%- include('partials/pagination', { page, label: 'Application pages' }) %>
          <% } else { %>
            <p><em>No applications submitted yet.</em></p>
          <% } %>
        </div>
      <% } %>

    <% } %> <!-- end applicant || admin block -->
  </main>

  <%- include('partials/footer') %>

</body>
</html>
