<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: title }) %>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    :root {
      --primary: #1976d2;
      --success: #2e7d32;
      --error: #d32f2f;
      --gray: #555;
      --light: #f9f9f9;
      --border: #ddd;
    }
    /* Form Styling */
    .application-form {
      max-width: 100%;
      margin: 1.5rem 0;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      font-size: 1rem;
    }
    .form-section {
      background: #fff;
      padding: 1.2rem;
      border-radius: 10px;
      border: 1px solid var(--border);
      box-shadow: 0 1px 4px rgba(0,0,0,.08);
    }
    .form-section h2 {
      margin: 0 0 1rem;
      padding-bottom: .5rem;
      border-bottom: 2px solid var(--primary);
      color: var(--primary);
      font-size: 1.3rem;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    label {
      font-weight: 600;
      color: #333;
    }
    input, select, textarea {
      padding: 0.75rem;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-size: 1rem;
      width: 100%;
      box-sizing: border-box;
      transition: border 0.2s;
    }
    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 2px rgba(25,118,210,.2);
    }
    input[readonly] {
      background: #f5f5f5;
      color: var(--gray);
      cursor: not-allowed;
    }
    textarea {
      resize: vertical;
      min-height: 100px;
    }
    button {
      background: var(--primary);
      color: white;
      border: none;
      padding: 0.9rem 1.8rem;
      font-size: 1.1rem;
      font-weight: 600;
      border-radius: 6px;
      cursor: pointer;
      align-self: flex-start;
      margin-top: 0.5rem;
      transition: background 0.2s;
    }
    button:hover {
      background: #1565c0;
    }
    /* Messages */
    .success { color: var(--success); font-weight: bold; }
    .error { color: var(--error); font-weight: bold; }

    /* Back link */
    main a {
      color: var(--primary);
      text-decoration: none;
    }
    main a:hover { text-decoration: underline; }

    /* ==================== ADMIN APPLICATIONS TABLE ==================== */
    .admin-applications {
      margin-top: 2.5rem;
    }
    .table-wrapper {
      overflow-x: auto;
      margin: 1.5rem 0;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,.1);
      background: #fff;
    }
    #applications-table {
      width: 100%;
      border-collapse: collapse;
      font-size: .95rem;
    }
    #applications-table th, #applications-table td {
      padding: .9rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }
    #applications-table thead th {
      background: #e3f2fd;
      position: sticky;
      top: 0;
      z-index: 1;
    }
    #applications-table tbody tr:hover {
      background: #f5faff;
    }
    th.sortable {
      cursor: pointer;
      user-select: none;
      position: relative;
      padding-right: 30px !important;
    }
    th.sortable:hover {
      background: #bbdefb !important;
    }
    th.sortable::after {
      content: "↕";
      position: absolute;
      right: 10px;
      opacity: 0.5;
      font-size: 1em;
    }
    th.sortable.asc::after {
      content: "↑";
      opacity: 1;
      font-weight: bold;
    }
    th.sortable.desc::after {
      content: "↓";
      opacity: 1;
      font-weight: bold;
    }
    .status-badge {
      padding: 4px 10px;
      border-radius: 20px;
      font-size: .85rem;
      font-weight: bold;
      color: white;
    }
    .status-pending { background: orange; }
    .status-approved { background: var(--success); }
    .status-rejected { background: var(--error); }

    /* Mobile stacked view */
    @media (max-width: 640px) {
      .table-wrapper { overflow-x: hidden; }
      #applications-table, thead, tbody, th, td, tr {
        display: block;
      }
      thead tr { position: absolute; top: -9999px; left: -9999px; }
      tr {
        margin-bottom: 1rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1rem;
        background: #fafafa;
        box-shadow: 0 1px 4px rgba(0,0,0,.08);
      }
      td {
        border: none;
        position: relative;
        padding-left: 50%;
        padding-top: .6rem;
        padding-bottom: .6rem;
      }
      td:before {
        content: attr(data-label);
        position: absolute;
        left: 12px;
        width: 45%;
        font-weight: bold;
        color: #444;
        white-space: nowrap;
      }
      .details-cell { padding-left: 12px; }
    }

    /* Print-friendly */
    @media print {
      .form-section, .table-wrapper { box-shadow: none; border: 1px solid #aaa; }
    }
  </style>
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>
<body>
  <%- include('partials/header') %>
  <main class="container">
    <h1>Application Form</h1>
    <% if (success) { %><p class="success">Application submitted successfully!</p><% } %>
    <% if (error) { %><p class="error"><%= error %></p><% } %>

    <!-- ==================== USER FORM ==================== -->
    <% if (user) { %>
      <form class="application-form" action="/apply" method="POST" novalidate>
        <% if (typeof csrfToken !== 'undefined') { %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% } %>
        <!-- Personal Information -->
        <div class="form-section">
          <h2>Personal Information</h2>
          <div class="form-group">
            <label>Name:</label>
            <input type="text" name="name" value="<%= user.name %>" readonly>
          </div>
          <div class="form-group">
            <label>Email:</label>
            <input type="email" name="email" value="<%= user.email %>" readonly>
          </div>
          <div class="form-group">
            <label>Phone Number *:</label>
            <input type="tel" name="phone" required placeholder="+266 1234 5678">
          </div>
          <div class="form-group">
            <label>Date of Birth *:</label>
            <input type="date" name="dob" required max="<%= new Date().toISOString().split('T')[0] %>">
          </div>
          <div class="form-group">
            <label>Street Address *:</label>
            <input type="text" name="street_address" required placeholder="123 Main Street">
          </div>
          <div class="form-group">
            <label>Town/City *:</label>
            <input type="text" name="town" required placeholder="Maseru">
          </div>
          <div class="form-group">
            <label>District *:</label>
            <select name="district" required>
              <option value="">Select District</option>
              <% ['Berea','Butha-Buthe','Leribe','Mafeteng','Maseru','Mohale\'s Hoek','Mokhotlong','Qacha\'s Nek','Quthing','Thaba-Tseka'].forEach(d => { %>
                <option value="<%= d %>"><%= d %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Postal Code *:</label>
            <input type="text" name="postal_code" required placeholder="100">
          </div>
          <div class="form-group">
            <label>Country:</label>
            <input type="text" name="country" value="Lesotho" readonly>
          </div>
        </div>
        <!-- High School -->
        <div class="form-section">
          <h2>High School Education</h2>
          <div class="form-group">
            <label>High School *:</label>
            <input type="text" name="high_school" required placeholder="Maseru High School">
          </div>
          <div class="form-group">
            <label>Graduation Year *:</label>
            <input type="number" name="grad_year" required min="1950" max="2030" placeholder="2024">
          </div>
        </div>
        <!-- Church / Spiritual -->
        <div class="form-section">
          <h2>Church & Spiritual Information</h2>
          <% const yesNo = ['','Yes','No']; %>
          <% ['salvation','baptism','holy_spirit','church_member','ministerial_credentials'].forEach(field => { %>
            <div class="form-group">
              <label><%= field.replace(/_/g,' ').replace(/\b\w/g, l => l.toUpperCase()) %> *:</label>
              <select name="<%= field %>" required>
                <% yesNo.forEach(opt => { %>
                  <option value="<%= opt %>"><%= opt || 'Select' %></option>
                <% }) %>
              </select>
            </div>
          <% }) %>
          <div class="form-group">
            <label>Current Church Name *:</label>
            <input type="text" name="current_church_name" required>
          </div>
          <div class="form-group">
            <label>Current Church City *:</label>
            <input type="text" name="current_church_city" required>
          </div>
          <div class="form-group">
            <label>Current Church Country *:</label>
            <input type="text" name="current_church_country" required value="Lesotho">
          </div>
          <div class="form-group">
            <label>Pastor's Name *:</label>
            <input type="text" name="pastor_name" required>
          </div>
          <div class="form-group">
            <label>Church Denominational Affiliation *:</label>
            <input type="text" name="church_denomination" required placeholder="e.g., Assemblies of God">
          </div>
          <div class="form-group">
            <label>Personal Denominational Affiliation *:</label>
            <input type="text" name="personal_denomination" required>
          </div>
          <div class="form-group">
            <label>Ministry Positions *:</label>
            <textarea name="ministry_positions" rows="4" required placeholder="List all current positions (e.g., Youth Leader, Worship Team)..."></textarea>
          </div>
          <div class="form-group">
            <label>National Church Leader Name *:</label>
            <input type="text" name="national_leader_name" required>
          </div>
          <div class="form-group">
            <label>Position *:</label>
            <input type="text" name="national_leader_position" required>
          </div>
          <div class="form-group">
            <label>Address & Contact *:</label>
            <textarea name="national_leader_address" rows="3" required placeholder="Full address, phone, email..."></textarea>
          </div>
        </div>
        <!-- Program -->
        <div class="form-section">
          <h2>Program Information</h2>
          <div class="form-group">
            <label>Program *:</label>
            <select name="program" required>
              <option value="">Select Program</option>
              <optgroup label="Level 1">
                <option value="Level 1 Certificate in Christian Discipleship">Level 1 Certificate in Christian Discipleship</option>
              </optgroup>
              <optgroup label="Level 2">
                <option value="Level 2 Diploma in Christian Leadership">Level 2 Diploma in Christian Leadership</option>
                <option value="Level 2 Certificate in Theology">Level 2 Certificate in Theology</option>
                <option value="Level 2 Certificate in Biblical Studies">Level 2 Certificate in Biblical Studies</option>
              </optgroup>
              <optgroup label="Level 3">
                <option value="Level 3 Advanced Diploma in Ministry">Level 3 Advanced Diploma in Ministry</option>
                <option value="Level 3 Diploma in Theology">Level 3 Diploma in Theology</option>
                <option value="Level 3 Diploma in Biblical Studies">Level 3 Diploma in Biblical Studies</option>
                <option value="Level 3 Diploma in Business Leadership">Level 3 Diploma in Business Leadership</option>
              </optgroup>
              <optgroup label="Level 4">
                <option value="Level 4 Higher Diploma in Shepherding">Level 4 Higher Diploma in Shepherding</option>
              </optgroup>
              <optgroup label="Level 5">
                <option value="Level 5 Bachelor of Ministry">Level 5 Bachelor of Ministry</option>
              </optgroup>
            </select>
          </div>
          <div class="form-group">
            <label>Semester *:</label>
            <select name="semester" required>
              <option value="">Select Semester</option>
              <option value="January 2026">January 2026</option>
              <option value="July 2026">July 2026</option>
              <option value="January 2027">January 2027</option>
            </select>
          </div>
          <div class="form-group">
            <label>Message (Optional):</label>
            <textarea name="message" rows="4" placeholder="Any additional information..."></textarea>
          </div>
          <p><strong>Application Fee: M200</strong> (Payable upon submission)</p>
          <button type="submit">Submit Application</button>
        </div>
      </form>
      <p><a href="/">Back to Home</a></p>

      <!-- ==================== ADMIN: ALL APPLICATIONS TABLE ==================== -->
      <% if (user.role === 'admin') { %>
        <hr>
        <div class="admin-applications">
          <h2>All Submitted Applications</h2>
          <% if (applications && applications.length > 0) { %>
            <div class="table-wrapper">
              <table id="applications-table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th class="sortable">Name</th>
                    <th class="sortable">Email</th>
                    <th class="sortable">Phone</th>
                    <th class="sortable">Program</th>
                    <th class="sortable">Semester</th>
                    <th class="sortable">Status</th>
                    <th class="sortable">Submitted</th>
                    <th>Details</th>
                  </tr>
                </thead>
                <tbody>
                  <% applications.forEach((app, index) => { %>
                    <tr>
                      <td data-label="#"> <%= index + 1 %> </td>
                      <td data-label="Name"> <%= app.name %> </td>
                      <td data-label="Email"> <%= app.email %> </td>
                      <td data-label="Phone"> <%= app.phone %> </td>
                      <td data-label="Program"> <%= app.program %> </td>
                      <td data-label="Semester"> <%= app.semester %> </td>
                      <td data-label="Status">
                        <span class="status-badge status-<%= (app.status || 'pending').toLowerCase() %>">
                          <%= (app.status || 'Pending').toUpperCase() %>
                        </span>
                      </td>
                      <td data-label="Submitted">
                        <%= new Date(app.submittedAt).toLocaleString('en-LS', { timeZone: 'Africa/Maseru' }) %>
                      </td>
                      <td data-label="Details" class="details-cell">
                        <details>
                          <summary style="cursor:pointer; color:var(--primary); font-weight:600;">View Details</summary>
                          <div style="margin-top:.8rem; line-height:1.6; font-size:.92rem;">
                            <div><strong>Personal:</strong> DOB <%= new Date(app.dob).toLocaleDateString() %>, <%= app.district %></div>
                            <div><strong>Education:</strong> <%= app.high_school %> (<%= app.grad_year %>)</div>
                            <div><strong>Church:</strong> <%= app.current_church_name %>, Pastor: <%= app.pastor_name %></div>
                            <% if (app.message) { %>
                              <div><strong>Message:</strong> <%= app.message %></div>
                            <% } %>
                          </div>
                        </details>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <p><em>No applications submitted yet.</em></p>
          <% } %>
        </div>
      <% } %>

    <% } else { %>
      <p>You must be logged in to apply. <a href="/auth/login">Login here</a></p>
    <% } %>
  </main>

  <%- include('partials/footer') %>

  <!-- Client-side sorting for applications table -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const table = document.getElementById("applications-table");
      if (!table) return;

      const headers = table.querySelectorAll("th.sortable");

      headers.forEach(header => {
        header.addEventListener("click", () => {
          const index = Array.from(header.parentNode.children).indexOf(header);
          const isAsc = header.classList.toggle("asc");
          if (!isAsc) header.classList.add("desc");
          else header.classList.remove("desc");

          headers.forEach(h => {
            if (h !== header) h.classList.remove("asc", "desc");
          });

          sortTable(table, index, isAsc);
        });
      });

      function sortTable(table, columnIndex, ascending) {
        const tbody = table.querySelector("tbody");
        const rows = Array.from(tbody.querySelectorAll("tr"));

        rows.sort((a, b) => {
          let valA = a.children[columnIndex].textContent.trim();
          let valB = b.children[columnIndex].textContent.trim();

          // Date column (Submitted)
          if (columnIndex === 7) {
            const dateA = new Date(valA);
            const dateB = new Date(valB);
            return ascending ? dateA - dateB : dateB - dateA;
          }

          // Status column - logical order: Pending → Approved → Rejected
          if (columnIndex === 6) {
            const order = { 'PENDING': 0, 'APPROVED': 1, 'REJECTED': 2 };
            const aOrder = order[valA.toUpperCase()] ?? -1;
            const bOrder = order[valB.toUpperCase()] ?? -1;
            return ascending ? aOrder - bOrder : bOrder - aOrder;
          }

          // Natural sort for text
          return ascending
            ? valA.localeCompare(valB, undefined, { numeric: true, sensitivity: 'base' })
            : valB.localeCompare(valA, undefined, { numeric: true, sensitivity: 'base' });
        });

        // Re-append sorted rows and renumber #
        rows.forEach((row, i) => {
          tbody.appendChild(row);
          row.children[0].textContent = i + 1;
        });
      }
    });
  </script>
</body>
</html>
