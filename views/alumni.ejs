<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: title, styles: ['/css/pages/alumni.css'] }) %>
<body>
  <%- include('partials/header') %>
  <main class="container">
    <h1>Alumni Registration</h1>

    <% if (success) { %><p class="success">Registration submitted successfully!</p><% } %>
    <% if (error)   { %><p class="error" role="alert"><%= error %></p><% } %>

    <!-- Role guard -->
    <% if (user.role === 'applicant') { %>
      <div class="info">This page is for alumni. If you'd like to apply to study, visit the <a href="/apply">Application Form</a>.</div>
    <% } else if (user.role === 'student') { %>
      <div class="info">This page is for alumni. Visit your <a href="/student-portal">Student Portal</a>.</div>
    <% } %>

    <% if (user.role === 'alumni' || user.role === 'admin') { %>

    <% if (user.role === 'alumni' && existingAlumni) { %>
      <!-- Already registered — show summary card -->
      <div class="profile-card" style="margin:1.5rem 0;">
        <h2 style="margin-top:0;">Your Alumni Registration</h2>
        <p><strong>Church:</strong> <%= existingAlumni.current_church_name %>, <%= existingAlumni.current_church_city %></p>
        <p><strong>Graduation Year:</strong> <%= existingAlumni.grad_year %></p>
        <p><strong>Submitted:</strong> <%= new Date(existingAlumni.submittedAt).toLocaleString('en-LS', { timeZone: 'Africa/Maseru' }) %></p>
        <p class="success">Your alumni registration has been received. Thank you!</p>
      </div>
    <% } else if (user.role === 'alumni') { %>
      <form class="alumni-form" action="/alumni" method="POST" data-restore="<%= JSON.stringify(form) %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h2>Personal Information</h2>

        <div class="form-group"><label for="f-name">Name:</label>
          <input id="f-name" type="text" name="name" value="<%= user.name %>" readonly></div>

        <div class="form-group"><label for="f-email">Email:</label>
          <input id="f-email" type="email" name="email" value="<%= user.email %>" readonly></div>

        <div class="form-group"><label for="f-phone">Phone Number *:</label>
          <input id="f-phone" type="tel" name="phone" required autocomplete="tel" placeholder="+266 5812 3456" value="<%= user.phoneNumber || '' %>"></div>

        <div class="form-group"><label for="f-dob">Date of Birth *:</label>
          <input id="f-dob" type="date" name="dob" required max="<%= new Date().toISOString().split('T')[0] %>"></div>

        <div class="form-group"><label for="f-street_address">Street Address *:</label>
          <input id="f-street_address" type="text" name="street_address" required placeholder="123 Main Street"></div>

        <div class="form-group"><label for="f-town">Town/City *:</label>
          <input id="f-town" type="text" name="town" required placeholder="Maseru"></div>

        <div class="form-group"><label for="f-district">District *:</label>
          <select id="f-district" name="district" required>
            <option value="">Select District</option>
            <option value="Berea">Berea</option>
            <option value="Butha-Buthe">Butha‑Buthe</option>
            <option value="Leribe">Leribe</option>
            <option value="Mafeteng">Mafeteng</option>
            <option value="Maseru">Maseru</option>
            <option value="Mohale's Hoek">Mohale's Hoek</option>
            <option value="Mokhotlong">Mokhotlong</option>
            <option value="Qacha's Nek">Qacha's Nek</option>
            <option value="Quthing">Quthing</option>
            <option value="Thaba-Tseka">Thaba‑Tseka</option>
          </select></div>

        <div class="form-group"><label for="f-postal_code">Postal Code *:</label>
          <input id="f-postal_code" type="text" name="postal_code" required placeholder="100"></div>

        <div class="form-group"><label for="f-country">Country:</label>
          <input id="f-country" type="text" name="country" value="Lesotho" readonly></div>

        <div class="form-group"><label for="f-grad_year">Graduation Year *:</label>
          <input id="f-grad_year" type="number" name="grad_year" required min="1950" max="<%= currentYear %>" placeholder="<%= currentYear - 1 %>"></div>

        <h2>Church Information</h2>

        <div class="form-group"><label for="f-current_church_name">Current Church Name *:</label>
          <input id="f-current_church_name" type="text" name="current_church_name" required></div>

        <div class="form-group"><label for="f-current_church_city">Current Church City *:</label>
          <input id="f-current_church_city" type="text" name="current_church_city" required></div>

        <div class="form-group"><label for="f-current_church_country">Current Church Country *:</label>
          <input id="f-current_church_country" type="text" name="current_church_country" required value="Lesotho"></div>

        <div class="form-group"><label for="f-pastor_name">Pastor's Name *:</label>
          <input id="f-pastor_name" type="text" name="pastor_name" required></div>

        <div class="form-group"><label for="f-church_member">Are you a member? *:</label>
          <select id="f-church_member" name="church_member" required>
            <option value="">Select</option>
            <option value="Yes">Yes</option>
            <option value="No">No</option>
          </select></div>

        <div class="form-group"><label for="f-church_denomination">Church Denominational Affiliation *:</label>
          <input id="f-church_denomination" type="text" name="church_denomination" required placeholder="e.g. Assemblies of God"></div>

        <div class="form-group"><label for="f-ministerial_credentials">Do you have ministerial credentials? *:</label>
          <select id="f-ministerial_credentials" name="ministerial_credentials" required>
            <option value="">Select</option>
            <option value="Yes">Yes</option>
            <option value="No">No</option>
          </select></div>

        <div class="form-group"><label for="f-ministry_positions">Ministry Positions *:</label>
          <textarea id="f-ministry_positions" name="ministry_positions" rows="4" required
                    placeholder="Pastor, Missionary, College Teacher, etc. – list ALL current positions with church/institution name."></textarea></div>

        <div class="form-group"><label for="f-national_leader_name">National Church Leader Name *:</label>
          <input id="f-national_leader_name" type="text" name="national_leader_name" required></div>

        <div class="form-group"><label for="f-national_leader_position">Position *:</label>
          <input id="f-national_leader_position" type="text" name="national_leader_position" required
                 placeholder="superintendent, bishop, general overseer, apostle, etc."></div>

        <div class="form-group"><label for="f-national_leader_address">Address & Contact *:</label>
          <textarea id="f-national_leader_address" name="national_leader_address" rows="3" required
                    placeholder="Full address, phone, email…"></textarea></div>

        <div class="form-group"><label for="f-message">Message (Optional):</label>
          <textarea id="f-message" name="message" rows="4"
                    placeholder="Any additional comments or questions."></textarea></div>

        <p><strong>Annual Subscription Fee: TBD</strong></p>
        <button type="submit">Submit Registration</button>
      </form>
    <% } %> <!-- end alumni form / existingAlumni block -->

      <p><a href="/">Back to Home</a></p>
    <% } %> <!-- end alumni || admin block -->

    <!-- ==================== ADMIN VIEW ==================== -->
    <% if (user.role === 'admin') { %>
      <hr>
      <div class="admin-section">
        <h2>All Alumni Submissions</h2>
        <% if (alumni.length > 0) { %>
          <% alumni.forEach((a, i) => { %>
            <details class="card">
              <summary>
                <span>#<%= page.offset + i + 1 %> – <%= a.name %> (<%= a.email %>)</span>
                <span>Grad Year: <%= a.grad_year %></span>
                <small>Submitted: <%= new Date(a.submittedAt)
                  .toLocaleString('en-LS',{timeZone:'Africa/Maseru'}) %></small>
              </summary>
              <div class="details">
                <div class="section"><strong>Personal</strong><br>
                  Phone: <%= a.phone %> | DOB: <%= new Date(a.dob).toLocaleDateString() %><br>
                  Address: <%= a.street_address %>, <%= a.town %>, <%= a.district %> <%= a.postal_code %>
                </div>

                <div class="section"><strong>Church</strong><br>
                  <%= a.current_church_name %>, <%= a.current_church_city %>, <%= a.current_church_country %><br>
                  Pastor: <%= a.pastor_name %> | Member: <%= a.church_member %><br>
                  Denomination: <%= a.church_denomination %> | Credentials: <%= a.ministerial_credentials %>
                </div>

                <div class="section"><strong>Ministry Positions</strong><br>
                  <pre><%= a.ministry_positions %></pre>
                </div>

                <div class="section"><strong>National Leader</strong><br>
                  <%= a.national_leader_name %> (<%= a.national_leader_position %>)<br>
                  <pre><%= a.national_leader_address %></pre>
                </div>

                <% if (a.message) { %>
                  <div class="section"><strong>Message</strong><br>
                    <pre><%= a.message %></pre>
                  </div>
                <% } %>
              </div>
            </details>
          <% }) %>
          <%- include('partials/pagination', { page, label: 'Alumni pages' }) %>
        <% } else { %>
          <p><em>No alumni submissions yet.</em></p>
        <% } %>
      </div>
    <% } %>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
