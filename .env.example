# Copy to .env and fill in. Never commit .env.

# MongoDB connection
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net
DB_NAME=calvary

# Long random string; required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Key people must enter to register an admin account. Leave empty to disable admin sign-up.
ADMIN_SECRET_KEY=

# Public URL of the site, used in password reset emails
BASE_URL=http://localhost:3000
PORT=3000

# Set to "production" when deployed (secure cookies, HTTPS upgrades, trust proxy)
NODE_ENV=development
# Set to 1 when running behind a reverse proxy outside production
TRUST_PROXY=

# Outgoing mail for password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
